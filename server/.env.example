# Copy to .env and fill in the values.

# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# CORS allow-list. Comma-separated; entries may use a wildcard, e.g.
#   CLIENT_URL=https://safetrail.vercel.app,http://localhost:5173
#   CLIENT_URL=https://*.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173
# Base URL used for links inside emails (verification, reset, invite, alerts).
# Required when CLIENT_URL contains only wildcards, because a link cannot point
# at https://*.vercel.app. Falls back to the first concrete CLIENT_URL entry.
# PUBLIC_APP_URL=https://safetrail.vercel.app
# Public URL of THIS API service. Used to register the Telegram webhook.
# On Render, RENDER_EXTERNAL_URL is used automatically when this is unset.
# SERVER_URL=https://safetrail-service.onrender.com

# ── Database ─────────────────────────────────────────────
# Local MongoDB:  mongodb://127.0.0.1:27017/safetrail
# Hosted MongoDB: mongodb+srv://<user>:<password>@<cluster>/safetrail
# (The database name is selected in models/db.js, so the path here is informational.)
MONGO_URI=mongodb://127.0.0.1:27017/safetrail

# ── Auth ─────────────────────────────────────────────────
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── SMTP (Nodemailer) — Brevo ────────────────────────────
# Required only for email features (verification, password reset, guardian
# invites, overdue/SOS alerts). These values are Brevo's SMTP relay (free plan:
# 300 emails/day, no card). Any other SMTP sender works too — swap host/port.
# Note: testmail.app only *receives* mail; it cannot be an SMTP_HOST.
#
# Setup:
#   1. Create an account at https://www.brevo.com (free plan)
#   2. Brevo → Settings → Senders & Domains: add and verify the address (or
#      domain) used in EMAIL_FROM, and publish its SPF/DKIM DNS records.
#   3. Brevo → SMTP & API → SMTP tab: copy the login and generate an SMTP key.
#      SMTP_USER is usually that login (your account email), SMTP_PASS the key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login@example.com
SMTP_PASS=your-brevo-smtp-key
# Must be a sender verified in Brevo, or delivery is rejected.
EMAIL_FROM="SafeTrail <no-reply@your-verified-domain.com>"
# Auto-detected from the port (465 = TLS). Override only if your provider needs it.
# SMTP_SECURE=true
# SMTP_REQUIRE_TLS=true
# Some hosts (Render's free tier) block the usual submission port. If the boot
# log says "Connection timeout", try SMTP_PORT=2525 or the provider's HTTPS API.
# Timeouts are in milliseconds; the defaults fail fast instead of hanging.
# SMTP_CONNECTION_TIMEOUT=15000
# SMTP_GREETING_TIMEOUT=10000
# SMTP_SOCKET_TIMEOUT=20000

# ── Email testing (testmail.app) ─────────────────────────
# When set, every outgoing email is redirected here and prefixed with the
# original recipient, so you can test real flows without emailing users.
# Inbox addresses: <namespace>.<tag>@inbox.testmail.app
# Get the namespace and API key from https://testmail.app/console/
EMAIL_TEST_TO=
TESTMAIL_API_KEY=
TESTMAIL_NAMESPACE=
TESTMAIL_TAG=safetrail

# ── Telegram bot (guardian alerts + /status /map /trips) ─
# 1. Talk to @BotFather → /newbot → copy the token below.
# 2. Optional: set TELEGRAM_WEBHOOK_SECRET to any long random string. When it is
#    empty, a secret is derived from the bot token, so commands still work.
# 3. Set SERVER_URL (or deploy on Render, where RENDER_EXTERNAL_URL is supplied)
#    and run: npm run telegram:webhook — the server also registers the webhook
#    itself on every boot.
# 4. In the app: Settings → Telegram → Connect.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=mysafetrailbot   # optional, saves one getMe call
# TELEGRAM_WEBHOOK_SECRET=
# How often live positions are pushed into the guardian's chat, in minutes.
# Telegram allows ~20 messages/minute per chat, so do not go below 1.
TELEGRAM_FEED_MINUTES=3

